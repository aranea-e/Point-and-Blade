          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 'The UI contains 3 bars for each player: Health, Stamina,
            and Adrenaline.<br><br>The Health bar starts at 100, and a player loses
            if it reaches 0.<br><br>The Stamina bar also starts at 100, and depletes
            while blocking. If it runs out, the player is left vulnerable for a short
            period.<br><br>The Adrenaline meter starts at 0, and on full charge,
            can be activated by blocking for a full restore of Stamina and a 33%
            restore of Health.'
          m_BoolArgument: 0
        m_CallState: 2
