      - m_Target: {fileID: 323253123}
        m_TargetAssemblyTypeName: HowToPlayMenu, Assembly-CSharp
        m_MethodName: SetMenu
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: The Adrenaline meter is a comeback mechanic that rewards
            you for doing well with the Health and Stamina to get back into the game.<br><br>Adrenaline
            fills by dealing damage or blocking incoming attacks. For each point
            of damage dealt, 2 points of Adrenaline are gained, and for each point
            of damage blocked, 3 points of Adrenaline are gained.<br><br>When a player
            has 100 Adrenaline, they can block to consume the meter. This sets Adrenaline
            back to 0, but gives a full restore of Stamina, and a 33% restore of
            Health.
          m_BoolArgument: 0
        m_CallState: 2
